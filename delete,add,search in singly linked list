#include <stdio.h>
#include <stdlib.h>

struct Node{
    int data;
    struct Node* next;
};

struct Node* createNode(int value){
    struct Node* newNode=(struct Node*)malloc(sizeof(struct Node));
    newNode->data=value;
    newNode->next=NULL;
    return newNode;
}

struct Node* insertBeg(struct Node* head,int value){
    struct Node* newNode=createNode(value);
    newNode->next=head;
    head=newNode;
    return head;
}

struct Node* insertEnd(struct Node* head,int value){
    struct Node* newNode=createNode(value);
    if(head==NULL)
        return newNode;
    struct Node* temp=head;
    while(temp->next!=NULL)
        temp=temp->next;
    temp->next=newNode;
    return head;
}

void display(struct Node* head){
    struct Node* temp=head;
    if(head==NULL){
        printf("List is empty\n");
        return;
    }
    while(temp!=NULL){
        printf("%d ",temp->data);
        temp=temp->next;
    }
    printf("\n");
}

void search(struct Node* head,int key){
    struct Node* temp=head;
    while(temp!=NULL){
        if(temp->data==key){
            printf("Roll number %d found\n",key);
            return;
        }
        temp=temp->next;
    }
    printf("Roll number %d not found\n",key);
}

struct Node* deleteNode(struct Node* head,int key){
    struct Node* temp=head;
    struct Node* prev=NULL;
    while(temp!=NULL && temp->data!=key){
        prev=temp;
        temp=temp->next;
    }
    if(temp==NULL){
        printf("Roll number %d not found\n",key);
        return head;
    }
    if(prev==NULL)
        head=head->next;
    else
        prev->next=temp->next;
    free(temp);
    printf("Roll number %d deleted\n",key);
    return head;
}

int main(){
    struct Node* head=NULL;
    int n,value,key,i,choice;
    printf("Enter number of students: ");
    scanf("%d",&n);
    printf("Enter roll numbers:\n");
    for(i=0;i<n;i++){
        scanf("%d",&value);
        head=insertEnd(head,value);
    }
    printf("Initial list: ");
    display(head);
    do{
        printf("\n1.Insert at beginning\n");
        printf("2.Insert at end\n");
        printf("3.Search roll number\n");
        printf("4.Delete roll number\n");
        printf("5.Display list\n");
        printf("6.Exit\n");
        printf("Enter choice: ");
        scanf("%d",&choice);
        switch(choice){
            case 1:
                printf("Enter roll number: ");
                scanf("%d",&value);
                head=insertBeg(head,value);
                printf("Updated list: ");
                display(head);
                break;
            case 2:
                printf("Enter roll number: ");
                scanf("%d",&value);
                head=insertEnd(head,value);
                printf("Updated list: ");
                display(head);
                break;
            case 3:
                printf("Enter roll number to search: ");
                scanf("%d",&key);
                search(head,key);
                printf("Current list: ");
                display(head);
                break;
            case 4:
                printf("Enter roll number to delete: ");
                scanf("%d",&key);
                head=deleteNode(head,key);
                printf("Updated list: ");
                display(head);
                break;
            case 5:
                display(head);
                break;
            case 6:
                printf("Exiting...\n");
                break;
            default:
                printf("Invalid choice\n");
        }
    }while(choice!=6);
    return 0;
}
